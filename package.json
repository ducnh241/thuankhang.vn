{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --config vite.frontend.config.js",
        "build:backend": "vite build",
        "build:frontend": "vite build --config vite.frontend.config.js",
        "dev": "concurrently -n backend,frontend -c blue,green \"vite\" \"vite --config vite.frontend.config.js\"",
        "dev:backend": "vite",
        "dev:frontend": "vite --config vite.frontend.config.js"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@tiptap/core": "^3.32.0",
        "@tiptap/extension-text-align": "^3.32.0",
        "@tiptap/extensions": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "jquery": "^3.7.1"
    }
}
