# Mẫu cấu hình môi trường. Chép thành .env rồi điền giá trị (không commit .env).
# local: APP_ENV=local, APP_DEBUG=true · staging: APP_ENV=staging, APP_DEBUG=false · production: APP_ENV=production,
# APP_DEBUG=false, SESSION_SECURE_COOKIE=true, LOG_LEVEL=warning
APP_NAME=ThuanKhang
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost

APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thuankhang_vn
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Bật khi chạy HTTPS (staging / prod)
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Tài khoản Root admin cho AdminUserSeeder (php artisan db:seed) — mật khẩu tối thiểu 12 ký tự
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Id tài khoản ẩn (hỗ trợ kỹ thuật), cách nhau dấu phẩy; để trống = không ẩn ai
BACKEND_HIDDEN_USERS=1
